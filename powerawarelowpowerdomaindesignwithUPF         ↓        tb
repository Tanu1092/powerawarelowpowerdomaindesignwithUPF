`timescale 1ns/1ps

module alu8_tb;

    reg  [7:0] A;
    reg  [7:0] B;
    reg  [2:0] ALU_Sel;

    wire [7:0] Result;
    wire       Carry;

    alu8 DUT (
        .A(A),
        .B(B),
        .ALU_Sel(ALU_Sel),
        .Result(Result),
        .Carry(Carry)
    );

    initial begin

        $monitor("Time=%0t A=%h B=%h Sel=%b Result=%h Carry=%b",
                 $time, A, B, ALU_Sel, Result, Carry);

        // Addition
        A = 8'h05;
        B = 8'h03;
        ALU_Sel = 3'b000;
        #10;

        // Subtraction
        A = 8'h08;
        B = 8'h03;
        ALU_Sel = 3'b001;
        #10;

        // AND
        A = 8'h0F;
        B = 8'h03;
        ALU_Sel = 3'b010;
        #10;

        // OR
        A = 8'h0F;
        B = 8'h30;
        ALU_Sel = 3'b011;
        #10;

        // XOR
        A = 8'h0F;
        B = 8'h03;
        ALU_Sel = 3'b100;
        #10;

        // NOT
        A = 8'h0F;
        B = 8'h00;
        ALU_Sel = 3'b101;
        #10;

        // Left shift
        A = 8'h04;
        B = 8'h00;
        ALU_Sel = 3'b110;
        #10;

        // Right shift
        A = 8'h08;
        B = 8'h00;
        ALU_Sel = 3'b111;
        #10;

        $finish;
    end

endmodule